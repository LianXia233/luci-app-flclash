#!/bin/sh
# Re-converge the transparent proxy after netifd interface events.
#
# fw4 reloads replay /var/run/flclash/fw4-input.nft by themselves, but the LAN
# device list and the dynamic WAN bypass set are computed from live interfaces.
# A short delay lets the interface finish acquiring its address.

[ -x /usr/libexec/flclash/proxy-rules.sh ] || exit 0

case "$ACTION" in
	ifup|ifupdate|ifdown) ;;
	*) exit 0 ;;
esac

case "$INTERFACE" in
	wan|wan6|lan|lan[0-9]*|*_lan) ;;
	*) exit 0 ;;
esac

( sleep 2; /usr/libexec/flclash/proxy-rules.sh sync >/dev/null 2>&1 ) &
exit 0
