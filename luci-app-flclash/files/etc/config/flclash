config flclash 'main'
	option enabled '1'
	option config_file '/etc/flclash/config.yaml'
	option external_controller '127.0.0.1:9097'
	option clash_api_port '9097'
	option tun_name ''
	option routing_mode ''
	option ipv6 '0'
	option mixed_port '7892'
	option mode 'rule'
	option log_level 'info'
	option tun_enabled '0'
	option core_type 'mihomo'
	option core_mode 'ipc'

config flclash 'proxy'
	option enabled '0'
	option backend ''
	option lan_if ''
	# Avoid silent IPv6 bypass on IPv4-only REDIRECT/TPROXY deployments.
	option filter_aaaa '1'
	# LAN ACL (Nikki-style). mode: all | allow | block
	# allow: only listed clients are proxied; block: listed clients bypass.
	option acl_mode 'all'
	# list acl_ip '192.168.1.50'
	# list acl_mac 'aa:bb:cc:dd:ee:ff'
	# Destination CIDRs that always bypass interception.
	# list bypass_cidr '10.10.0.0/16'
	# Destination ports that always bypass (e.g. 25 for SMTP).
	# list bypass_port '25'
	# Take over the router's own outbound traffic (mihomo only).
	option local_takeover '1'

config flclash 'api'
	option enabled '1'
	option listen '0.0.0.0:9098'
	option ui_dir '/www/flclash'
	option data_dir '/etc/flclash'
	option secret ''

config flclash 'webui'
	option enabled '1'
	option webui_path '/flclash/'
	option webui_port '9098'
