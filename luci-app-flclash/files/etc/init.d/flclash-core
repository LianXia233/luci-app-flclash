#!/bin/sh /etc/rc.common
# FlClash core - procd service for OpenWrt master / SNAPSHOT.
# Only starts/stops the proxy core. All configuration lives in the WebUI.
#
# Two mihomo runtimes are supported:
#   core_mode=ipc (default) - the bundled FlClash (chen08209/FlClash) core is a
#     gomobile/IPC binary that opens no ports on its own. flclash-core-bridge
#     drives it over IPC (core.init -> config.setup -> listener.start). This is
#     the native, zero-patch way to run the FlClash core on OpenWrt.
#   core_mode=cli           - a standalone mihomo CLI (e.g. installed by the
#     online updater) started with the classic -d/-f/-ext-ctl flags.
# sing-box uses its own `run -c` CLI with a converted JSON config.

START=95
STOP=05
USE_PROCD=1

# Generated configs contain proxy credentials; never publish them 0644.
umask 077

get_option() {
	local section="$1" option="$2" default="$3" value
	config_get value "$section" "$option"
	[ -n "$value" ] && echo "$value" || echo "$default"
}

# mihomo refuses to start without a config file, which used to leave the
# service in a permanent respawn loop on first install.
ensure_config() {
	local file="$1" port controller mode level
	[ -s "$file" ] && return 0

	port="$(get_option main mixed_port 7892)"
	controller="$(get_option main external_controller 127.0.0.1:9097)"
	mode="$(get_option main mode rule)"
	level="$(get_option main log_level warning)"

	mkdir -p "$(dirname "$file")"
	cat > "$file" <<EOF
mixed-port: $port
redir-port: 7893
tproxy-port: 7894
external-controller: $controller
mode: $mode
log-level: $level
allow-lan: false
ipv6: true
EOF
}

start_service() {
	config_load flclash

	local enabled config_file controller core_type core_mode core_bin
	enabled="$(get_option main enabled 1)"
	[ "$enabled" = "0" ] && return 0

	config_file="$(get_option main config_file /etc/flclash/config.yaml)"
	controller="$(get_option main external_controller 127.0.0.1:9097)"
	core_type="$(get_option main core_type mihomo)"
	core_mode="$(get_option main core_mode ipc)"

	# Select the installed binary for the chosen core.
	if [ "$core_type" = "sing-box" ] && [ -x /usr/bin/sing-box ]; then
		core_bin=/usr/bin/sing-box
	else
		core_type=mihomo
		core_bin=/usr/bin/mihomo
	fi

	[ -x "$core_bin" ] || {
		logger -t flclash-core "core binary missing: $core_bin"
		return 1
	}

	ensure_config "$config_file"
	# A killed core can leave TUN policy routing behind. The old instance is
	# already stopped on restart, so clean it before listener.start rebuilds it.
	[ -x /usr/libexec/flclash/proxy-rules.sh ] && \
		/usr/libexec/flclash/proxy-rules.sh purge >/dev/null 2>&1
	# The native IPC core applies TUN only during listener.start. Prepare all
	# device-critical keys now; a controller reload alone cannot start TUN.
	/usr/libexec/flclash/proxy-rules.sh prepare >/dev/null 2>&1

	procd_open_instance flclash-core
	# Route controller Geo DB downloads through the local mihomo proxy.
	# GODEBUG=http2client=0 avoids CDN HTTP/2 handshakes being reset (EOF).
	# GOMEMLIMIT is a soft cap for the Go runtime; on 256MB routers the default
	# heap growth can otherwise end in the OOM killer taking down dnsmasq.
	local mem_kb mem_limit
	mem_kb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null)
	[ -n "$mem_kb" ] || mem_kb=262144
	mem_limit=$((mem_kb * 40 / 100 / 1024))
	[ "$mem_limit" -ge 64 ] || mem_limit=64
	procd_set_param env GOMEMLIMIT="${mem_limit}MiB" GOGC=50 HTTPS_PROXY=http://127.0.0.1:7892 HTTP_PROXY=http://127.0.0.1:7892 NO_PROXY=127.0.0.1,localhost,::1 GODEBUG=http2client=0
	if [ "$core_type" = "sing-box" ]; then
		# sing-box uses its own JSON config. Translate the Clash-format
		# config.yaml on the fly; if the converter is missing or fails, fall
		# back to treating config_file as a sing-box native config.
		local sb_config=/tmp/flclash-singbox.json
		if [ -x /usr/libexec/flclash/singbox-convert.sh ] \
			&& /usr/libexec/flclash/singbox-convert.sh "$config_file" "$sb_config" >/dev/null 2>&1 \
			&& [ -s "$sb_config" ]; then
			config_file=$sb_config
			chmod 0600 "$config_file" 2>/dev/null
		fi
		# Legacy rule-set download_detour is emitted by default; allow it on
		# sing-box 1.14+ until the converter moves to the new syntax.
		procd_set_param env ENABLE_DEPRECATED_LEGACY_RULE_SET_DOWNLOAD_DETOUR=true
		# Keep sing-box as root here. On some procd builds dropping to the
		# sing-box user leaves the instance in a crash loop (verified on
		# ImmortalWrt snapshot). proxy-rules.sh skips the local OUTPUT redirect
		# when this core is active, since sing-box has no routing-mark to
		# exempt its own outbound from the redirect (would form a loop).
		procd_set_param command "$core_bin" run -c "$config_file"
	elif [ "$core_mode" = "cli" ] || [ ! -x /usr/bin/flclash-core-bridge ]; then
		# Standalone mihomo CLI (including the auto-update path).
		procd_set_param command "$core_bin" -d "$(dirname "$config_file")" -f "$config_file" -ext-ctl "$controller"
	else
		# Default: drive the FlClash native IPC core through the Rust bridge.
		procd_set_param command /usr/bin/flclash-core-bridge \
			-socket /tmp/flclash-core.sock \
			-core "$core_bin" \
			-home-dir "$(dirname "$config_file")" \
			-config "$config_file"
	fi
	procd_set_param file "$config_file" /etc/config/flclash
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn "${respawn_threshold:-3600}" "${respawn_timeout:-5}" "${respawn_retry:-5}"
	procd_set_param limits nofile="65536 65536"
	procd_close_instance

	# Converge after the controller and listeners are ready. Detached so procd
	# startup is not blocked by IPC/MMDB initialization.
	( sleep 5; /usr/libexec/flclash/proxy-rules.sh sync >/dev/null 2>&1 ) &
}

stop_service() {
	# procd kills the core after this hook; delayed sync then removes stale
	# REDIRECT/TUN artifacts and restores DNS without clearing the UCI wish.
	( sleep 3; /usr/libexec/flclash/proxy-rules.sh sync >/dev/null 2>&1 ) &
}

service_triggers() {
	procd_add_reload_trigger flclash
}

reload_service() {
	stop
	start
}
