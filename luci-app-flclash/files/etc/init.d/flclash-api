#!/bin/sh /etc/rc.common
# FlClash WebUI API bridge (static Go, stdlib only).

START=96
STOP=04
USE_PROCD=1

start_service() {
	config_load flclash

	local enabled listen controller ui data secret
	config_get_bool enabled api enabled 1
	[ "$enabled" = "1" ] || return 0

	config_get listen api listen '0.0.0.0:9098'
	config_get controller main external_controller '127.0.0.1:9097'
	config_get ui api ui_dir '/www/flclash'
	config_get data api data_dir '/etc/flclash'
	config_get secret api secret ''

	# The API can rewrite configs, install cores, restore backups and drive the
	# firewall. A LAN-reachable listener with an empty secret is therefore an
	# unauthenticated root console; at least make the exposure visible.
	case "$listen" in
		127.0.0.1:*|localhost:*|\[::1\]:*) ;;
		*)
			[ -n "$secret" ] || logger -t flclash-api \
				"WARNING: $listen is reachable from the LAN without flclash.api.secret (unauthenticated control of the proxy)"
			;;
	esac

	[ -x /usr/bin/flclash-api ] || {
		logger -t flclash-api "bridge binary missing: /usr/bin/flclash-api"
		return 1
	}

	mkdir -p "$data"

	procd_open_instance flclash-api
	procd_set_param command /usr/bin/flclash-api \
		-listen "$listen" \
		-controller "$controller" \
		-ui "$ui" \
		-data "$data" \
		-init /etc/init.d/flclash-core
	# Geo DB refresh downloads cannot reach GitHub directly; route the
	# controller HTTP client through the local mihomo mixed-port.
	procd_set_param env FLCLASH_API_SECRET="$secret" HTTPS_PROXY=http://127.0.0.1:7892 HTTP_PROXY=http://127.0.0.1:7892 NO_PROXY=127.0.0.1,localhost,::1
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger flclash
}

reload_service() {
	stop
	start
}
