#!/bin/sh /etc/rc.common
# Restores the LAN transparent-proxy takeover after a reboot when the UCI
# flag was left enabled. The flag itself is written by proxy-rules.sh.

START=97
STOP=10

start() {
	/usr/libexec/flclash/proxy-rules.sh boot
}

stop() {
	# Keep the UCI wish so boot can restore takeover; only remove live rules.
	/usr/libexec/flclash/proxy-rules.sh teardown >/dev/null 2>&1
}

restart() {
	start
}
