#!/bin/sh /etc/rc.common
# Independent reconciler for core/DNS liveness (see libexec/watchdog.sh).

START=98
STOP=09
USE_PROCD=1

start_service() {
	procd_open_instance flclash-watchdog
	procd_set_param command /usr/libexec/flclash/watchdog.sh
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 5
	procd_close_instance
}
