{
  "luci-app-flclash-webui": {
    "description": "Control the FlClash core/service and read live system proxy information",
    "read": {
      "ubus": {
        "flclash": ["system_proxy", "service_state", "core_log", "core_update_status"]
      },
      "uci": ["flclash"]
    },
    "write": {
      "ubus": {
        "flclash": ["service_toggle", "core_update"]
      },
      "file": {
        "exec": {
          "/etc/init.d/flclash-core": ["start", "stop", "restart", "status"],
          "/etc/init.d/flclash-api": ["start", "stop", "restart", "status"]
        }
      }
    }
  }
}
