{
  "luci-app-flclash-webui": {
    "description": "Start/stop the FlClash core and read live system proxy information",
    "read": {
      "ubus": {
        "flclash": ["system_proxy"]
      },
      "uci": ["flclash"]
    },
    "write": {
      "file": {
        "exec": {
          "/etc/init.d/flclash-core": ["start", "stop", "restart"],
          "/etc/init.d/flclash-api": ["start", "stop", "restart"]
        }
      }
    }
  }
}
