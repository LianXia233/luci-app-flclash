#!/bin/sh /etc/rc.common
# FlClash mihomo core - procd service for OpenWrt master/SNAPSHOT
# Only starts/stops the Go core. All configuration lives in the WebUI.

START=95
STOP=05
USE_PROCD=1

get_option() {
	local section="$1" option="$2" default="$3" value
	config_get value "$section" "$option"
	[ -n "$value" ] && echo "$value" || echo "$default"
}

# mihomo refuses to start without a config file, which used to leave the
# service in a permanent respawn loop on first install.
ensure_config() {
	local file="$1" port controller mode level
	[ -s "$file" ] && return 0

	port="$(get_option main mixed_port 7892)"
	controller="$(get_option main external_controller 127.0.0.1:9097)"
	mode="$(get_option main mode rule)"
	level="$(get_option main log_level info)"

	mkdir -p "$(dirname "$file")"
	cat > "$file" <<EOF
mixed-port: $port
external-controller: $controller
mode: $mode
log-level: $level
allow-lan: false
ipv6: true
EOF
}

start_service() {
	config_load flclash

	local enabled config_file controller core_type core_bin
	enabled="$(get_option main enabled 1)"
	[ "$enabled" = "0" ] && return 0

	config_file="$(get_option main config_file /etc/flclash/config.yaml)"
	controller="$(get_option main external_controller 127.0.0.1:9097)"
	core_type="$(get_option main core_type mihomo)"

	# Select the installed binary for the chosen core. sing-box uses its own
	# `run -c` CLI; mihomo keeps the Clash-style flags the WebUI expects.
	if [ "$core_type" = "sing-box" ] && [ -x /usr/bin/sing-box ]; then
		core_bin=/usr/bin/sing-box
	else
		core_type=mihomo
		core_bin=/usr/bin/mihomo
	fi

	[ -x "$core_bin" ] || {
		logger -t flclash-core "core binary missing: $core_bin"
		return 1
	}

	ensure_config "$config_file"

	procd_open_instance flclash-core
	if [ "$core_type" = "sing-box" ]; then
		# sing-box uses its own JSON config. An optional converter hook may
		# translate the Clash-format config.yaml; if it is absent, config_file
		# is expected to already hold a sing-box native config. This keeps the
		# core switch usable without shipping a lossy YAML->JSON translator.
		if [ -x /usr/libexec/flclash/singbox-convert.sh ]; then
			/usr/libexec/flclash/singbox-convert.sh "$config_file" /tmp/flclash-singbox.json >/dev/null 2>&1 \
				&& config_file=/tmp/flclash-singbox.json
		fi
		procd_set_param command "$core_bin" run -c "$config_file"
	else
		procd_set_param command "$core_bin" -d "$(dirname "$config_file")" -f "$config_file" -ext-ctl "$controller"
	fi
	procd_set_param file "$config_file" /etc/config/flclash
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn "${respawn_threshold:-3600}" "${respawn_timeout:-5}" "${respawn_retry:-5}"
	procd_set_param limits nofile="65536 65536"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger flclash
}

reload_service() {
	stop
	start
}
