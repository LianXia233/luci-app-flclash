#!/bin/sh /etc/rc.common
# FlClash mihomo core - procd service for OpenWrt master/SNAPSHOT
# Only starts/stops the Go core. All configuration lives in the WebUI.

START=95
STOP=05
USE_PROCD=1

get_option() {
	local section="$1" option="$2" default="$3" value
	config_get value "$section" "$option"
	[ -n "$value" ] && echo "$value" || echo "$default"
}

# mihomo refuses to start without a config file, which used to leave the
# service in a permanent respawn loop on first install.
ensure_config() {
	local file="$1" port controller mode level
	[ -s "$file" ] && return 0

	port="$(get_option main mixed_port 7892)"
	controller="$(get_option main external_controller 127.0.0.1:9097)"
	mode="$(get_option main mode rule)"
	level="$(get_option main log_level info)"

	mkdir -p "$(dirname "$file")"
	cat > "$file" <<EOF
mixed-port: $port
external-controller: $controller
mode: $mode
log-level: $level
allow-lan: false
ipv6: true
EOF
}

start_service() {
	config_load flclash

	local enabled config_file controller
	enabled="$(get_option main enabled 1)"
	[ "$enabled" = "0" ] && return 0

	config_file="$(get_option main config_file /etc/flclash/config.yaml)"
	controller="$(get_option main external_controller 127.0.0.1:9097)"

	[ -x /usr/bin/mihomo ] || {
		logger -t flclash-core "core binary missing: /usr/bin/mihomo"
		return 1
	}

	ensure_config "$config_file"

	procd_open_instance flclash-core
	procd_set_param command /usr/bin/mihomo -d "$(dirname "$config_file")" -f "$config_file" -ext-ctl "$controller"
	procd_set_param file "$config_file" /etc/config/flclash
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn "${respawn_threshold:-3600}" "${respawn_timeout:-5}" "${respawn_retry:-5}"
	procd_set_param limits nofile="65536 65536"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger flclash
}

reload_service() {
	stop
	start
}
